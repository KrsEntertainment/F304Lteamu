{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && cp -r public/* dist/ 2>/dev/null || true; mkdir -p dist && cp data/state.json dist/state.json 2>/dev/null || true",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "test:sync": "node scripts/sync-test.mjs",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "start": "deno run -A --unstable-kv main.ts",
    "test:server": "node scripts/e2e-server.mjs",
    "test:app": "node scripts/e2e-app.mjs",
    "test:merge": "node scripts/merge-test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "deno": "^2.9.6",
    "lucide-react": "^1.73.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
